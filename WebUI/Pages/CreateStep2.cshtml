@page
@model WebUI.Pages.CreateStep2Model
@{
    ViewData["Title"] = "Create Invoice - Step 2";
}

<input type="hidden" id="csrfToken" value="@Model.AntiforgeryToken" />

<h1>Create Invoice — Step 2 of 2</h1>
<p class="text-muted">Invoice items add karo, phir Create Invoice par click karo.</p>

<div id="step1Summary" class="alert alert-secondary"></div>

<table class="table" id="itemsTable">
    <thead>
        <tr>
            <th>Product</th>
            <th>Special Offer</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Discount</th>
            <th>Line Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="invoiceItems"></tbody>
</table>

<button type="button" class="btn btn-light btn-sm" id="addItemBtn">+ Add Item</button>

<div class="mt-3">
    <strong>Grand Total: <span id="grandTotal">0.00</span></strong>
</div>

<div class="mt-3">
    <button type="button" class="btn btn-secondary" id="backBtn">← Back</button>
    <button type="button" class="btn btn-primary" id="createBtn">Create Invoice</button>
</div>

<div id="errorBox" class="alert alert-danger mt-3" style="display:none;"></div>

@section Scripts {
    <script>
        const products = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                    Model.Products,
                    new System.Text.Json.JsonSerializerOptions
                    {
                                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
                    }));

        let itemIndex = 0;

        // --- Step 1 data check ---
        const step1Raw = sessionStorage.getItem("invoiceStep1");
        if (!step1Raw) {
            alert("Step 1 data not found please fill again.");
            window.location.href = "/CreateStep1";
        }
        const step1Data = JSON.parse(step1Raw);

        document.getElementById("step1Summary").innerText =
            `Customer #${step1Data.customerId} | Due: ${step1Data.dueDate} | Ship Method ID: ${step1Data.shipMethodId}`;

        document.getElementById("backBtn").addEventListener("click", () => {
            window.location.href = "/CreateStep1";
        });

        document.getElementById("addItemBtn").addEventListener("click", addItemRow);

        function addItemRow() {
            const index = itemIndex++;
            const tbody = document.getElementById("invoiceItems");

            const row = document.createElement("tr");
            row.dataset.index = index;

            const productOptions = products
                .map(p => `<option value="${p.productId}" data-price="${p.listPrice}">${p.productName}</option>`)
                .join("");

            row.innerHTML = `
                    <td>
                        <select class="form-select product-select">
                            <option value="">-- Select --</option>
                            ${productOptions}
                        </select>
                    </td>
                    <td>
                        <select class="form-select offer-select">
                            <option value="0">No Offer</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control qty-input" value="1" min="1" /></td>
                    <td><input type="number" step="0.01" class="form-control price-input" value="0" /></td>
                    <td><input type="number" step="0.01" class="form-control discount-input" value="0" min="0" max="1" /></td>
                    <td class="line-total">0.00</td>
                    <td><button type="button" class="btn btn-danger btn-sm remove-item">X</button></td>
                `;

            tbody.appendChild(row);
            wireRowEvents(row);
        }

        function wireRowEvents(row) {
            const productSelect = row.querySelector(".product-select");
            const offerSelect = row.querySelector(".offer-select");
            const qtyInput = row.querySelector(".qty-input");
            const priceInput = row.querySelector(".price-input");
            const discountInput = row.querySelector(".discount-input");
            const removeBtn = row.querySelector(".remove-item");

            productSelect.addEventListener("change", async () => {
                const selected = productSelect.selectedOptions[0];
                priceInput.value = selected ? (selected.dataset.price || 0) : 0;

                const productId = productSelect.value;
                offerSelect.innerHTML = `<option value="0">No Offer</option>`;

                if (productId) {
                    const response = await fetch(`/CreateStep2?handler=SpecialOffers&productId=${productId}`);
                    if (response.ok) {
                        const offers = await response.json();
                        offers.forEach(o => {
                            const opt = document.createElement("option");
                            opt.value = o.specialOfferId;
                            opt.textContent = `${o.description} (${(o.discountPct * 100).toFixed(0)}%)`;
                            opt.dataset.discount = o.discountPct;
                            offerSelect.appendChild(opt);
                        });
                    }
                }

                recalculateRow(row);
            });

            offerSelect.addEventListener("change", () => {
                const selected = offerSelect.selectedOptions[0];
                discountInput.value = selected?.dataset.discount || 0;
                recalculateRow(row);
            });

            qtyInput.addEventListener("input", () => recalculateRow(row));
            priceInput.addEventListener("input", () => recalculateRow(row));
            discountInput.addEventListener("input", () => recalculateRow(row));

            removeBtn.addEventListener("click", () => {
                row.remove();
                recalculateGrandTotal();
            });
        }

        function recalculateRow(row) {
            const qty = parseFloat(row.querySelector(".qty-input").value) || 0;
            const price = parseFloat(row.querySelector(".price-input").value) || 0;
            const discount = parseFloat(row.querySelector(".discount-input").value) || 0;

            const lineTotal = price * (1 - discount) * qty;
            row.querySelector(".line-total").textContent = lineTotal.toFixed(2);

            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let total = 0;
            document.querySelectorAll(".line-total").forEach(cell => {
                total += parseFloat(cell.textContent) || 0;
            });
            document.getElementById("grandTotal").textContent = total.toFixed(2);
        }

        // --- Final Submit: Step1 (sessionStorage) + Step2 (items) combine karke POST ---
        document.getElementById("createBtn").addEventListener("click", async () => {
            const rows = document.querySelectorAll("#invoiceItems tr");

            if (rows.length === 0) {
                alert("Add Atleast 1 Item!");
                return;
            }

            const details = Array.from(rows).map(row => ({
                productId: parseInt(row.querySelector(".product-select").value),
                specialOfferId: parseInt(row.querySelector(".offer-select").value) || 0,
                orderQty: parseInt(row.querySelector(".qty-input").value),
                unitPrice: parseFloat(row.querySelector(".price-input").value),
                unitPriceDiscount: parseFloat(row.querySelector(".discount-input").value)
            }));

            const invoicePayload = {
                customerId: step1Data.customerId,
                dueDate: step1Data.dueDate,
                billToAddressId: step1Data.billToAddressId,
                shipToAddressId: step1Data.shipToAddressId,
                shipMethodId: step1Data.shipMethodId,
                comment: step1Data.comment,
                details: details
            };

            const errorBox = document.getElementById("errorBox");
            errorBox.style.display = "none";

            const csrfToken = document.getElementById("csrfToken").value;

            try {
                const response = await fetch("/CreateStep2?handler=Submit", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRF-TOKEN": csrfToken
                    },
                    body: JSON.stringify(invoicePayload)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    sessionStorage.removeItem("invoiceStep1");
                    window.location.href = "/Index";
                } else {
                    errorBox.textContent = "Error: " + ("Something went wrong, Try again in 10 mins");
                    errorBox.style.display = "block";
                }
            } catch (err) {
                errorBox.textContent = "Network error: " + err.message;
                errorBox.style.display = "block";
            }
        });
    </script>
}