@page
@model WebUI.Pages.CreateModel
@{
    ViewData["Title"] = "Create Invoice";
}

<h1>Create Invoice</h1>

<form method="post" id="invoiceForm">
    <div class="row mb-3">
        <div class="col">
            <label>Customer</label>
            <select asp-for="Invoice.CustomerId" class="form-select">
                <option value="">-- Select --</option>
                @foreach (var c in Model.FormData.Customers)
                {
                    <option value="@c.CustomerId">Customer #@c.CustomerId</option>
                }
            </select>
        </div>
        <div class="col">
            <label>Due Date</label>
            <input asp-for="Invoice.DueDate" type="date" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Bill To Address</label>
            <select asp-for="Invoice.BillToAddressId" class="form-select">
                <option value="">-- Select --</option>
                @foreach (var a in Model.FormData.Addresses)
                {
                    <option value="@a.AddressId">@a.DisplayName</option>
                }
            </select>
        </div>
        <div class="col">
            <label>Ship To Address</label>
            <select asp-for="Invoice.ShipToAddressId" class="form-select">
                <option value="">-- Select --</option>
                @foreach (var a in Model.FormData.Addresses)
                {
                    <option value="@a.AddressId">@a.DisplayName</option>
                }
            </select>
        </div>
        <div class="col">
            <label>Ship Method</label>
            <select asp-for="Invoice.ShipMethodId" class="form-select">
                <option value="">-- Select --</option>
                @foreach (var sm in Model.FormData.ShipMethods)
                {
                    <option value="@sm.Id">@sm.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label>Comment</label>
        <input asp-for="Invoice.Comment" class="form-control" />
    </div>

    <h4>Invoice Items</h4>
    <table class="table" id="itemsTable">
        <thead>
            <tr>
                <th>Product</th>
                <th>Special Offer</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Discount</th>
                <th>Line Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="invoiceItems"></tbody>
    </table>

    <button type="button" class="btn btn-light btn-sm" id="addItemBtn">
        + Add Item
    </button>

    <div class="mt-3">
        <strong>Grand Total: <span id="grandTotal">0.00</span></strong>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create Invoice</button>
    </div>
</form>

@section Scripts {
    <script>
        const products = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(Model.FormData.Products));

        let itemIndex = 0;

        document.getElementById("addItemBtn").addEventListener("click", addItemRow);

        function addItemRow() {
            const index = itemIndex++;
            const tbody = document.getElementById("invoiceItems");

            const row = document.createElement("tr");
            row.dataset.index = index;
      
            const productOptions = products
                .map(p => `<option value="${p.ProductId}" data-price="${p.ListPrice}">${p.ProductName}</option>`)
                .join("");

            row.innerHTML = `
                    <td>
                        <select class="form-select product-select" name="Invoice.Details[${index}].ProductId">
                            <option value="">-- Select --</option>
                            ${productOptions}
                        </select>
                    </td>
                    <td>
                        <select class="form-select offer-select" name="Invoice.Details[${index}].SpecialOfferId">
                            <option value="0">No Offer</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" class="form-control qty-input" name="Invoice.Details[${index}].OrderQty" value="1" min="1" />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control price-input" name="Invoice.Details[${index}].UnitPrice" value="0" />
                    </td>
                    <td>
                        <input type="number" step="0.01" class="form-control discount-input" name="Invoice.Details[${index}].UnitPriceDiscount" value="0" min="0" max="1" />
                    </td>
                    <td class="line-total">0.00</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm remove-item">X</button>
                    </td>
                `;

            tbody.appendChild(row);
            wireRowEvents(row);
        }

        function wireRowEvents(row) {
            const productSelect = row.querySelector(".product-select");
            const offerSelect = row.querySelector(".offer-select");
            const qtyInput = row.querySelector(".qty-input");
            const priceInput = row.querySelector(".price-input");
            const discountInput = row.querySelector(".discount-input");
            const removeBtn = row.querySelector(".remove-item");

            productSelect.addEventListener("change", async () => {
                const selected = productSelect.selectedOptions[0];
                const price = selected ? selected.dataset.price : 0;
                priceInput.value = price || 0;

                const productId = productSelect.value;
                offerSelect.innerHTML = `<option value="0">No Offer</option>`;

                if (productId) {
                    const response = await fetch(`/Create?handler=SpecialOffers&productId=${productId}`);
                    if (response.ok) {
                        const offers = await response.json();
                        offers.forEach(o => {
                            const opt = document.createElement("option");
                            opt.value = o.specialOfferId;
                            opt.textContent = `${o.description} (${(o.discountPct * 100).toFixed(0)}%)`;
                            opt.dataset.discount = o.discountPct;
                            offerSelect.appendChild(opt);
                        });
                    }
                }

                recalculateRow(row);
            });

            offerSelect.addEventListener("change", () => {
                const selected = offerSelect.selectedOptions[0];
                discountInput.value = selected?.dataset.discount || 0;
                recalculateRow(row);
            });

            qtyInput.addEventListener("input", () => recalculateRow(row));
            priceInput.addEventListener("input", () => recalculateRow(row));
            discountInput.addEventListener("input", () => recalculateRow(row));

            removeBtn.addEventListener("click", () => {
                row.remove();
                recalculateGrandTotal();
            });
        }

        function recalculateRow(row) {
            const qty = parseFloat(row.querySelector(".qty-input").value) || 0;
            const price = parseFloat(row.querySelector(".price-input").value) || 0;
            const discount = parseFloat(row.querySelector(".discount-input").value) || 0;

            const lineTotal = price * (1 - discount) * qty;
            row.querySelector(".line-total").textContent = lineTotal.toFixed(2);

            recalculateGrandTotal();
        }

        function recalculateGrandTotal() {
            let total = 0;
            document.querySelectorAll(".line-total").forEach(cell => {
                total += parseFloat(cell.textContent) || 0;
            });
            document.getElementById("grandTotal").textContent = total.toFixed(2);
        }

        // Start with one row by default
        addItemRow();
    </script>
}